---
import Layout from '../../layouts/Layout.astro';
import projects from '../../data/studio-projects-en.json';
const studio = 'https://studio.ainunijlal.com/';
const certificates = [
  { name:'Google AI Professional Certificate', issuer:'Google · Coursera', date:'May 19, 2026', id:'MO7032DDEDA9', slug:'google-ai-professional', url:'https://coursera.org/verify/professional-cert/MO7032DDEDA9' },
  { name:'Google Prompting Essentials', issuer:'Google · Coursera', date:'May 20, 2026', id:'SDW818ZUUQBK', slug:'google-prompting-essentials', url:'https://coursera.org/verify/specialization/SDW818ZUUQBK' },
  { name:'Google AI Essentials', issuer:'Google · Coursera', date:'May 19, 2026', id:'S11J3KW9W8V3', slug:'google-ai-essentials', url:'https://coursera.org/verify/specialization/S11J3KW9W8V3' },
  { name:'Frontend Developer Skills and Best Practices', issuer:'Scrimba · Coursera', date:'May 20, 2026', id:'M9HNWN6SZHWV', slug:'frontend-developer-skills', url:'https://coursera.org/verify/specialization/M9HNWN6SZHWV' },
  { name:'Spec-Driven Development dengan Kiro', issuer:'Dicoding', date:'May 17, 2026', id:'KEXLQM48MPG2', slug:'kiro-dicoding', url:'https://dicoding.com/certificates/KEXLQM48MPG2' }
];
const socials = [ ['LinkedIn','https://www.linkedin.com/in/ainunijlal'], ['GitHub','https://github.com/ijlal-code'], ['Instagram','https://www.instagram.com/ainunijlal_ai/'], ['TikTok','https://www.tiktok.com/@ainunijlal'], ['YouTube','https://www.youtube.com/@ainunijlal'] ];
---
<Layout>
  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar wrap">
    <a class="brand" href="#top"><img src="/images/logo-ainun.png" alt="" width="42" height="42" /><span>AINUN IJLAL<small>WEB DEVELOPER</small></span></a>
    <nav aria-label="Main navigation"><a href="#tentang">About</a><a href="#proyek">Projects</a><a href="#sertifikasi">Certifications</a><a href="#kontak">Contact</a></nav>
    <div class="header-actions"><nav class="language-switch" aria-label="Choose language"><a href="/" lang="id">ID</a><a href="/en/" lang="en" aria-current="page">EN</a></nav><a class="header-link" href="mailto:ijlalainun@gmail.com">Let’s talk</a></div>
  </header>
  <main id="main">
    <section class="hero wrap" id="top">
      <div class="hero-copy"><p class="eyebrow">WEB DEVELOPER PORTFOLIO</p><h1>Hello, I’m<br /><em>Ainun Ijlal.</em></h1><p class="hero-lead">A web developer from Majene building applications for real needs.</p><div class="actions"><a class="button primary" href="#proyek">View projects</a><a class="text-link" href="/CV-Ainun-Ijlal.pdf" target="_blank" rel="noopener noreferrer">View CV</a></div><div class="hero-meta"><div><span>BASED IN</span><strong>Majene, West Sulawesi</strong></div><div><span>FOCUS</span><strong>Web Development</strong></div></div></div>
    </section>
    <section class="section wrap" id="tentang"><div class="section-label"><span>01 / ABOUT</span><span>GET TO KNOW ME</span></div><div class="intro-grid"><h2>Digital solutions<br /><em>built around</em><br />real needs.</h2><div><p>I’m Ainun Ijlal, an undergraduate Informatics student at Universitas Sulawesi Barat focused on web development. My CV lists me as a seventh-semester student.</p><p>I interned with Tonasa’s Internal Audit unit, developed an internship monitoring LMS with SMKN 1 Majene, and built a Laravel application for an organization. I value research, analysis, problem-solving, and useful solutions, and I can adapt and lead a team.</p><a class="text-link gold" href="/CV-Ainun-Ijlal.pdf" target="_blank" rel="noopener noreferrer">View full CV</a></div></div><div class="facts"><div><strong>02</strong><span>FEATURED PROJECTS</span></div><div><strong>22</strong><span>STUDIO CONCEPTS</span></div><div><strong>05</strong><span>CERTIFICATIONS</span></div><div><strong>01</strong><span>FOCUS: WEB DEVELOPMENT</span></div></div></section>
    <section class="section wrap" id="proyek"><div class="section-label"><span>02 / PROJECTS</span><span>SELECTED DIGITAL WORK</span></div><div class="section-heading"><div><p class="eyebrow">FROM IDEA TO IMPLEMENTATION</p><h2>Work that<br /><em>works.</em></h2></div><p>Projects built around real needs to make workflows simpler.</p></div>
      <div class="featured-grid">
        <article class="featured"><a class="project-image" href="https://pkl.smkn1majene.sch.id/" target="_blank" rel="noopener noreferrer"><img src="/images/projects/lms-pkl-dashboard.png" alt="LMS Monitoring PKL interface for SMKN 1 Majene" width="1896" height="883" loading="lazy" /><span>View website</span></a><div class="card-content"><div class="card-meta"><span>01 / EDUCATION</span><span>2026</span></div><h3>LMS Monitoring PKL</h3><p>A collaboration with SMKN 1 Majene that replaces manual records with a digital system. It supports daily journals, attendance, monitoring, assessments, and automatic document summaries for students, supervising teachers, and administrators. Teachers can review and validate activities remotely.</p><div class="tags"><span>WEB APP</span><span>MONITORING</span><span>EDUCATION</span></div><a class="text-link gold" href="https://pkl.smkn1majene.sch.id/" target="_blank" rel="noopener noreferrer">View project</a></div></article>
        <article class="featured"><a class="project-image" href="https://github.com/tesxsss-cell/pintar_aset" target="_blank" rel="noopener noreferrer"><img src="/images/projects/pintar-aset-dashboard.png" alt="Pintar Aset application dashboard" width="1893" height="886" loading="lazy" /><span>View repository</span></a><div class="card-content"><div class="card-meta"><span>02 / ORGANIZATION SYSTEM</span><span>2026</span></div><h3>Pintar Aset</h3><p>A Laravel web application for an organization, developed through requirements research, analysis, and problem-solving. The project records 32 GitHub commits and uses GitHub Actions to automate deployment from local development to hosting.</p><div class="tags"><span>LARAVEL</span><span>GITHUB ACTIONS</span><span>CI/CD</span></div><a class="text-link gold" href="https://github.com/tesxsss-cell/pintar_aset" target="_blank" rel="noopener noreferrer">View repository</a></div></article>
      </div>
      <div class="studio-intro"><div><p class="eyebrow">AINUN IJLAL STUDIO</p><h2>Need a website<br /><em>for your idea?</em></h2></div><div><p>Ainun Ijlal Studio is my website for web development services and collaboration. Explore landing page concepts or discuss a company profile, digital invitation, professional portfolio, or custom web application.</p><a class="button outline" href={studio} target="_blank" rel="noopener noreferrer">Visit Studio</a></div></div>
      <div class="studio-heading"><div><p class="eyebrow">EXPLORE / 22 CONCEPTS</p><h3>Studio inspiration</h3></div><p>Design concepts across different fields, not claims of client work. Previews open Studio in a new tab.</p></div>
      <div class="studio-grid">{projects.slice(0,6).map((project, i) => <article class="studio-card"><a href={studio} target="_blank" rel="noopener noreferrer" aria-label={`Preview ${project.name} at Ainun Ijlal Studio (new tab)`}><img src={project.image} alt={`Design preview of ${project.name}`} width="640" height="400" loading="lazy" /><div class="studio-card-copy"><span>STUDIO / {String(i+1).padStart(2,'0')}</span><h4>{project.name}</h4><p>{project.description}</p><b>Preview at Studio</b></div></a></article>)}</div>
      <details class="more"><summary><span class="closed-label">Show more projects</span><span class="open-label">Show fewer projects</span> </summary><div class="more-body"><div class="studio-grid">{projects.slice(6).map((project, i) => <article class="studio-card"><a href={studio} target="_blank" rel="noopener noreferrer" aria-label={`Preview ${project.name} at Ainun Ijlal Studio (new tab)`}><img src={project.image} alt={`Design preview of ${project.name}`} width="640" height="400" loading="lazy" /><div class="studio-card-copy"><span>STUDIO / {String(i+7).padStart(2,'0')}</span><h4>{project.name}</h4><p>{project.description}</p><b>Preview at Studio</b></div></a></article>)}</div><button class="more-close" type="button" hidden>Show fewer projects</button></div></details>
    </section>
    <section class="section skills-band" id="keahlian"><div class="wrap"><div class="section-label"><span>03 / SKILLS</span><span>TOOLS & CAPABILITIES</span></div><div class="intro-grid skills-layout"><div><h2>Learn, build,<br /><em>improve.</em></h2><p class="support">I enjoy understanding problems, analyzing workflows, and finding solutions with a team.</p></div><div class="skill-groups"><div><h3>01 Technical</h3><div class="tags">{['HTML','CSS','JavaScript','Tailwind CSS','Laravel','Git','GitHub','GitHub Actions','CI/CD','Figma','Canva'].map(x => <span>{x}</span>)}</div></div><div><h3>02 Interpersonal</h3><div class="tags">{['Research','Analysis','Problem-solving','Teamwork','Adaptability','Team leadership'].map(x => <span>{x}</span>)}</div></div><div><h3>03 Languages</h3><div class="tags"><span>Indonesian</span><span>English</span></div></div></div></div></div></section>
    <section class="section wrap" id="sertifikasi"><div class="section-label"><span>04 / CERTIFICATIONS</span><span>KEEP LEARNING</span></div><div class="section-heading"><div><p class="eyebrow">CONTINUOUS LEARNING</p><h2>There is always<br /><em>more to learn.</em></h2></div><p>Five certificates from Google, Scrimba, and Dicoding. Open an image to view the PDF or use the verification link.</p></div><div class="certificates">{certificates.map((c,i)=><article class="certificate"><a class="certificate-image" href={`/certificates/${c.slug}.pdf`} target="_blank" rel="noopener noreferrer" aria-label={`View the ${c.name} certificate PDF (new tab)`}><img src={`/images/certificates/${c.slug}.webp`} alt={`${c.name} certificate awarded to Ainun Ijlal`} width="1300" height="1005" loading="lazy" decoding="async" /></a><div class="certificate-content"><span class="cert-no">CERTIFICATE / {String(i+1).padStart(2,'0')}</span><h3>{c.name}</h3><p>{c.issuer} · {c.date}</p><div class="certificate-links"><a href={`/certificates/${c.slug}.pdf`} target="_blank" rel="noopener noreferrer">View certificate PDF</a><a href={c.url} target="_blank" rel="noopener noreferrer" aria-label={`Verify ${c.name}, ID ${c.id} (new tab)`}>Verify: {c.id}</a></div></div></article>)}</div></section>
    <section class="section wrap" id="pengalaman"><div class="section-label"><span>05 / JOURNEY</span><span>EXPERIENCE & EDUCATION</span></div><div class="section-heading"><h2>Experience &<br /><em>education.</em></h2></div><div class="timeline"><article><span>JANUARY TO FEBRUARY 2026</span><div><h3>Tonasa · Internal Audit Unit</h3><p>Intern · Pangkep, South Sulawesi</p><ul><li>Built a web system for monitoring and meeting attendance.</li><li>Developed a document storage website to make ISO files easier to find.</li><li>Organized Excel data and presented it in readable charts.</li><li>Assisted with the “Tonasa Menginspirasi” school outreach activity alongside a supervisor.</li></ul></div></article><article><span>2023 TO PRESENT</span><div><h3>Informatic Study Club</h3><p>Web Division Member · Universitas Sulawesi Barat</p><p>Participated in web development learning activities, collaborating and sharing knowledge with fellow Informatics students.</p></div></article><article><span>2023 TO PRESENT</span><div><h3>Universitas Sulawesi Barat</h3><p>Bachelor’s in Informatics · Semester 7 (as stated in CV) · Focus on web development.</p></div></article></div></section>
    <section class="contact section" id="kontak"><div class="wrap"><div class="section-label"><span>06 / CONTACT</span><span>LET'S CONNECT</span></div><div class="contact-grid"><div><h2>Have an idea?<br /><em>Let’s build it.</em></h2><p>Open to discussing projects, collaborations, and professional opportunities in web development.</p><a class="button primary" href="mailto:ijlalainun@gmail.com">Send email</a></div><div class="contact-details"><div><span>EMAIL</span><a href="mailto:ijlalainun@gmail.com">ijlalainun@gmail.com</a></div><div><span>LOCATION</span><p>Majene, West Sulawesi, Indonesia</p></div><div><span>SOCIAL & NETWORK</span><div class="socials">{socials.map(([name,url]) => <a href={url} target="_blank" rel="noopener noreferrer">{name}</a>)}</div></div></div></div></div></section>
  </main>
  <footer class="wrap footer"><div><span>BUILT WITH INTENTION · AINUN IJLAL</span><a href="#top">Back to top</a></div><p>AINUN <em>IJLAL.</em></p><small>© {new Date().getFullYear()} AINUN IJLAL · MAJENE, INDONESIA</small></footer>
</Layout>
